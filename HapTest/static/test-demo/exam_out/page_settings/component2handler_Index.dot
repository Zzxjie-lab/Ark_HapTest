digraph G {
    graph [nodesep=0.1]
    node [shape=box]
    edge [arrowhead=vee]
    Node0 [label="root"]
    Node0extra [shape=ellipse label="extra\nxpath: root" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node0 -> Node0extra
    Node1 [label="Navigation"]
    Node0 -> Node1
    Node1val [shape=ellipse label="StateValues
 pathStack|windowWidth" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
    Node1 -> Node1val
    Node1attributes [shape=ellipse label="property|Event
creat...e|mode|navBarWidth|hideToolBar|width|height|backgroundColor" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
    Node1 -> Node1attributes
    Node1extra [shape=ellipse label="extra\nxpath: root/Navigation" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node1 -> Node1extra
}