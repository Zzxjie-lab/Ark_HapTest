    Node1attributes [shape=ellipse label="property|Event
create|height|width|padding|borderRadius|backgroundColor|onTouch" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
    Node1 -> Node1attributes
    Node1extra [shape=ellipse label="extra\nxpath: root/Row" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node1 -> Node1extra
    Node2 [label="Text"]
    Node1 -> Node2
    Node2val [shape=ellipse label="StateValues
 title" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
