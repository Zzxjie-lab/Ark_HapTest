digraph G {
    graph [nodesep=0.1]
    node [shape=box]
    edge [arrowhead=vee]
    Node0 [label="root"]
    Node0extra [shape=ellipse label="extra\nxpath: root" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node0 -> Node0extra
    Node1 [label="Row"]
