    Node2attributes [shape=ellipse label="property|Event
create|fontSize|fontColor|fontWeight|textAlign" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
    Node2 -> Node2attributes
    Node2extra [shape=ellipse label="extra\nxpath: root/Row/Text" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node2 -> Node2extra
    Node3 [label="Blank"]
    Node1 -> Node3
    Node3attributes [shape=ellipse label="property|Event
create" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
    Node3 -> Node3attributes
