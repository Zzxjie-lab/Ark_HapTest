    Node4attributes [shape=ellipse label="property|Event
create|fontSize|lineHeight|align|fontWeight|fontFamily|fontColor" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
    Node4 -> Node4attributes
    Node4extra [shape=ellipse label="extra\nxpath: root/Row/Text" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
