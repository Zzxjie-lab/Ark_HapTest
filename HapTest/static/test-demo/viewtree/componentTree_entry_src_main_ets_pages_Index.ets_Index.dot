digraph G {
    graph [nodesep=0.1]
    node [shape=box]
    edge [arrowhead=vee]
    Node0 [label="root"]
    Node0extra [shape=ellipse label="extra\nxpath: root" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node0 -> Node0extra
    Node1 [label="RelativeContainer"]
    Node0 -> Node1
    Node1attributes [shape=ellipse label="property|Event
create|height|width" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
    Node1 -> Node1attributes
    Node1extra [shape=ellipse label="extra\nxpath: root/RelativeContainer" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node1 -> Node1extra
    Node2 [label="Text"]
    Node1 -> Node2
    Node2val [shape=ellipse label="StateValues
 message" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
    Node2 -> Node2val
    Node2attributes [shape=ellipse label="property|Event
create|id|fontSize|fontWeight|alignRules|onClick" fontsize=10 height=.1 style=filled color=".7 .3 1.0" ]
    Node2 -> Node2attributes
    Node2extra [shape=ellipse label="extra\nxpath: root/RelativeContainer/Text" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node2 -> Node2extra
}