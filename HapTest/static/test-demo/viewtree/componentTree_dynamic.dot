digraph G {
    graph [nodesep=0.1]
    node [shape=box]
    edge [arrowhead=vee]
    Node0 [label="root" style=filled color="orange"]
    undefined -> Node0
    Node0extra [shape=ellipse label="extra\nxpath: root" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node0 -> Node0extra
    Node1 [label="RelativeContainer" style=filled color="orange"]
    Node0 -> Node1
    Node1extra [shape=ellipse label="extra\nxpath: root/RelativeContainer" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node1 -> Node1extra
    Node2 [label="Text" style=filled color="orange"]
    Node1 -> Node2
    Node2extra [shape=ellipse label="extra\ntext: Welcome" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node2 -> Node2extra
    Node2extra [shape=ellipse label="extra\nxpath: root/RelativeContainer/Text" fontsize=10 height=.1 style=filled color=".7 .3 1.0"]
    Node2 -> Node2extra
}